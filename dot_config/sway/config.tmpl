### Variablen
set $mod Mod4
# -a foot-terminal und -a foot-nvim vergeben eindeutige app_ids für die automatische Workspace-Zuordnung
set $term foot -a foot-terminal -e tmux
set $rofi_cmd rofi -terminal '$term'
floating_modifier $mod normal

### Fest zugeordnete Arbeitsflächen (Automatische Zuordnung beim Start)
assign [app_id="org.mozilla.firefox"] workspace number 1
assign [app_id="foot-terminal"] workspace number 2
assign [app_id="foot-nvim"] workspace number 3
assign [app_id="thunar"] workspace number 4

### Bildschirme & Anzeigen
output * bg ~/.config/sway/thinknix-d.svg fill
output * scale 1.0 scale_filter nearest

{{ if eq .chezmoi.osRelease.id "fedora" -}}
output eDP-1 pos 0 0
output DP-4 pos 1920 0
exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
{{ end -}}

{{ if eq .chezmoi.osRelease.id "nixos" -}}
exec waybar
{{ end -}}

### Eingabegeräte
input type:keyboard {
    xkb_layout de
    xkb_variant nodeadkeys
}

### Erscheinungsbild
default_border pixel 2
gaps inner 2
gaps outer 1

client.focused          #cc0000 #1a1a1a    #ffffff  #cc0000   #cc0000
client.unfocused        #333333 #1a1a1a    #888888  #333333   #333333
client.focused_inactive #333333 #1a1a1a    #888888  #333333   #333333

### Tastenkürzel: Anwendungsstarter (Springt zum Ziel-Workspace & startet App)
bindsym $mod+e exec swaymsg "workspace number 1; exec flatpak run org.mozilla.firefox"
bindsym $mod+q exec swaymsg "workspace number 2; exec $term"
bindsym $mod+v exec swaymsg "workspace number 3; exec foot -a foot-nvim -e tmux new-session nvim"
bindsym $mod+f exec swaymsg "workspace number 4; exec thunar"

### Tastenkürzel: Anwendungsstarter (Auf aktuellem Workspace starten)
bindsym $mod+Shift+e exec flatpak run org.mozilla.firefox
bindsym $mod+Shift+q exec foot -e tmux
bindsym $mod+Shift+v exec foot -e nvim

### Tastenkürzel: System & Dienstprogramme
bindsym $mod+c kill # Fenster schließen

# Fn+W (Arrow Up) sendet KEY_SLEEP – blockieren, damit Rechner nicht einschläft
bindsym XF86Sleep nop

## Rofi Skripte
bindsym $mod+s exec ~/.config/sway/scripts/drun-launcher.sh # Anwendungsmenü (Rofi)
bindsym $mod+w exec ~/.config/sway/scripts/tmux-session-picker.sh # Tmux Session Picker
# Interaktives Hilfesystem
bindsym $mod+i exec ~/.config/sway/scripts/sway-keybind-help.sh # Tastenkürzel-Hilfemenü

## Screenshot Skripte
bindsym $mod+Shift+Print exec ~/.config/sway/scripts/screenshot/screenshot-ocr.sh # mod shift print 
bindsym $mod+Print exec ~/.config/sway/scripts/screenshot/screenshot.sh # mod print

## Bluetooth und Netzwerk
bindsym $mod+b exec blueman-manager # Bluetooth-Verwaltung
bindsym $mod+n exec nm-connection-editor # Netzwerk-Verwaltung

## Monitor
bindsym $mod+m exec ~/.config/sway/scripts/toggle-monitor-light-on-off.sh # Monitorlicht umschalten

## Drucker (noch nicht fertig aber voll funktional. Es fehlt Schnittstelle und Pipeline)
bindsym $mod+Shift+p exec ~/.config/sway/scripts/send_print_command_drugga.sh # Druckbefehl senden

## Lupe (Maus) 
# BUG GEFUNDEN: Nvim: Caught deadly signal 'SIGTERM'
# Verhalten: Wenn ich die Lupe aktiviere, ist Nvim abgeschmiert im aktuellen Terminal.
bindsym --whole-window $mod+button2 exec ~/.config/sway/scripts/toggle-magnification.sh # Bildschirm-Lupe umschalten

## Navigation & Fensterbewegung innerhalb des Workspaces
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+h focus left   # Fokus nach links
bindsym $mod+j focus down   # Fokus nach unten
bindsym $mod+k focus up     # Fokus nach oben
bindsym $mod+l focus right  # Fokus nach rechts

#bindsym $mod+Shift+h move left   # Kachel nach links tauschen
#bindsym $mod+Shift+j move down   # Kachel nach unten tauschen
#bindsym $mod+Shift+k move up     # Kachel nach oben tauschen
#bindsym $mod+Shift+l move right  # Kachel nach rechts tauschen

## Größe anpassen (Resize Modus)
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 10 px
    bindsym l resize grow width 10 px
    bindsym k resize shrink height 10 px
    bindsym j resize grow height 10 px
    
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### Bedingte System-Funktionen (Chezmoi OS-Unterscheidung)
{{ if eq .chezmoi.osRelease.id "fedora" -}}
bindsym $mod+F11 fullscreen toggle # Vollbild umschalten
bindsym $mod+F12 mode "passthrough" # Tastenkürzel-Durchleitung aktivieren

mode "passthrough" {
    bindsym $mod+F12 mode "default"
}
{{ end -}}


### Externe Konfigurationsdateien einbinden (Includes)
{{ if eq .chezmoi.osRelease.id "nixos" -}}
include /etc/sway/config.d/*.conf
include ~/.config/sway/config.d/*.conf
{{ else -}}
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
{{ end -}}

