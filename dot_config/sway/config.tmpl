# Binde Caps+Kombinationen direkt mit AltGr in Sway
bindsym Mod5+8 exec wtype '['
bindsym Mod5+9 exec wtype ']'
bindsym Mod5+7 exec wtype '{'
bindsym Mod5+0 exec wtype '}'

### Variablen
set $mod Mod4
set $term foot -a foot-terminal -e tmux
set $rofi_cmd rofi -terminal '$term'

### Arbeitsflächen- & Fensterverhalten
hide_edge_borders smart
smart_gaps on

### Bildschirme & Anzeigen
output * bg ~/.config/sway/thinknix-d.svg fill
output * scale 1.0 scale_filter nearest

{{ if eq .chezmoi.osRelease.id "fedora" -}}
output eDP-1 pos 0 0
output DP-4 pos 1920 0
exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
{{ end -}}

{{ if eq .chezmoi.osRelease.id "nixos" -}}
exec waybar
{{ end -}}

### Erscheinungsbild
default_border pixel 2
gaps inner 2
gaps outer 1

client.focused          #cc0000 #1a1a1a    #ffffff  #cc0000   #cc0000
client.unfocused        #333333 #1a1a1a    #888888  #333333   #333333
client.focused_inactive #333333 #1a1a1a    #888888  #333333   #333333

### Tastenkürzel: Anwendungsstarter (Springt zum Ziel-Workspace & startet App)
bindsym $mod+e exec swaymsg "workspace number 1; exec flatpak run org.mozilla.firefox"
bindsym $mod+q exec swaymsg "workspace number 2; exec $term"
bindsym $mod+j exec swaymsg "workspace number 3; exec foot -a foot-nvim -e tmux new-session nvim"
bindsym $mod+f exec swaymsg "workspace number 4; exec thunar"

### Tastenkürzel: Anwendungsstarter (Auf aktuellem Workspace starten)
bindsym $mod+Shift+e exec flatpak run org.mozilla.firefox
bindsym $mod+Shift+q exec $term
bindsym $mod+Shift+j exec foot -e nvim
bindsym $mod+Shift+f exec thunar

### Tastenkürzel: System & Dienstprogramme
bindsym $mod+c kill
bindsym $mod+s exec ~/.config/sway/scripts/drun-launcher.sh
bindsym $mod+w exec ~/.config/sway/scripts/tmux-session-picker.sh
bindsym $mod+b exec blueman-manager
bindsym $mod+n exec nm-connection-editor
bindsym $mod+m exec ~/.config/sway/scripts/toggle-monitor-light-on-off.sh
bindsym $mod+Shift+p exec ~/.config/sway/scripts/send_print_command_drugga.sh

# Interaktives Hilfesystem
bindsym $mod+h exec ~/.config/sway/scripts/keybind_help_page_drun-launcher.sh

# Lupe (Maus)
bindsym --whole-window $mod+button2 exec ~/.config/sway/scripts/toggle-magnification.sh

### Layout-Splitting
bindsym $mod+g splith
bindsym $mod+v splitv

### Tastenkürzel: Navigation & Fensterbewegung innerhalb des Workspaces
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Größe anpassen (Resize Modus)
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym l resize shrink width 10 px
    bindsym k resize grow height 10 px
    bindsym j resize shrink height 10 px
    bindsym h resize grow width 10 px
    
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### Bedingte System-Funktionen (Chezmoi OS-Unterscheidung)
{{ if eq .chezmoi.osRelease.id "fedora" -}}
bindsym $mod+F11 fullscreen toggle
bindsym $mod+F12 mode "passthrough"

mode "passthrough" {
    bindsym $mod+F12 mode "default"
}
{{ end -}}

### Externe Konfigurationsdateien einbinden (Includes)
{{ if eq .chezmoi.osRelease.id "nixos" -}}
include /etc/sway/config.d/*.conf
include ~/.config/sway/config.d/*.conf
{{ else -}}
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
{{ end -}}

### Eingabegeräte & Layout (Standard DE; Kanata verarbeitet Modifier auf Kernel-Ebene)
input type:keyboard {
    xkb_layout de
    xkb_variant nodeadkeys
    repeat_delay 200
    repeat_rate 40
}
