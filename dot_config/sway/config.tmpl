# Read `man 5 sway` for a complete reference.

### Variables

set $mod Mod4
set $term foot -e tmux
set $rofi_cmd rofi -terminal '$term'

### Output

output * bg #000000 solid_color
output * scale 1.2 scale_filter nearest

{{ if eq .chezmoi.osRelease.id "fedora" -}}
output eDP-1 pos 0 0
output DP-4 pos 1600 0

exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
{{ end -}}

{{ if eq .chezmoi.osRelease.id "nixos" -}}
exec waybar
{{ end -}}

### Input

input type:keyboard {
    xkb_layout de
    xkb_variant nodeadkeys
}

### Style

default_border pixel 2
gaps inner 2
gaps outer 1

# class                 border  background text    indicator child_border
client.focused          #cc0000 #1a1a1a    #ffffff #cc0000   #cc0000
client.unfocused        #333333 #1a1a1a    #888888 #333333   #333333
client.focused_inactive #333333 #1a1a1a    #888888 #333333   #333333

### Key bindings

    bindsym $mod+q exec $term
    bindsym $mod+c kill
    bindsym $mod+s exec ~/.config/sway/scripts/drun-launcher.sh
    bindsym $mod+w exec ~/.config/sway/scripts/tmux-session-picker.sh
    bindsym $mod+e exec flatpak run org.mozilla.firefox
    bindsym $mod+b exec blueman-manager
    bindsym $mod+n exec nm-connection-editor
    bindsym $mod+j exec foot -e tmux new-session nvim

    floating_modifier $mod normal

### Movement

    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right

### Scratchpad

    bindsym $mod+Shift+minus move scratchpad
    bindsym $mod+minus scratchpad show

{{ if eq .chezmoi.osRelease.id "fedora" -}}
### Fullscreen-Toggle
    bindsym $mod+F11 fullscreen toggle

### Passthrough-Mode (z.B. fuer Moonlight: alle Keys an die App weiterleiten)
### Aktivieren: $mod+F12 | Deaktivieren: $mod+F12
    bindsym $mod+F12 mode "passthrough"
    mode "passthrough" {
        bindsym $mod+F12 mode "default"
    }

{{ end -}}
{{ if eq .chezmoi.osRelease.id "nixos" -}}
include /etc/sway/config.d/*.conf
include ~/.config/sway/config.d/*.conf
{{ else -}}
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
{{ end -}}
