# Path to oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="robbyrussell"

# Plugins
plugins=(zsh-autosuggestions)

# History
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

source $ZSH/oh-my-zsh.sh

PROMPT="%n@%m $PROMPT"

# Disable git in prompt
git_prompt_info() { }

# Case-insensitive Tab-Completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# World-writable dirs: gelb statt blau-auf-grün
_CUSTOM_COLORS="ow=01;33:tw=01;33:*.mov=00"
LS_COLORS="$LS_COLORS:$_CUSTOM_COLORS"
export LS_COLORS
_ZSH_COLORS="${_CUSTOM_COLORS}:${LS_COLORS}"
zstyle ':completion:*:default' list-colors ${(s.:.)_ZSH_COLORS}
unset _CUSTOM_COLORS _ZSH_COLORS

# Aliases
alias ll="ls -la"
alias ..="cd .."
alias rm="trash-put"
alias start-webserver="python3 -m http.server"
unalias md 2>/dev/null
md() {
    [[ -z "$1" ]] && { echo "Usage: md <file.md>"; return 1; }
    pkill -f "grip .* 6419" 2>/dev/null
    sleep 0.3
    grip "$1" 6419 &>/dev/null &!
    sleep 0.5
    flatpak run org.mozilla.firefox --new-tab http://localhost:6419 &>/dev/null &!
}
show-image() { flatpak run --filesystem=host org.gnome.gThumb "$(realpath "${1:-.}")" 2>/dev/null; }

# Toolbox/Distrobox indicator
if [ -f /run/.containerenv ]; then
    source /run/.containerenv
    if [ -n "$DISTROBOX_ENTER_PATH" ]; then
        PROMPT="(distrobox: $name) $PROMPT"
    else
        PROMPT="(toolbox: $name) $PROMPT"
    fi
fi
