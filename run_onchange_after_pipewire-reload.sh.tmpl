#!/bin/bash
# Reload PipeWire when pipewire.conf.d changes — runs before swaymsg-reload (p < s).
# chezmoi hash: {{ include "dot_config/pipewire/pipewire.conf.d/10-waybar-sinks.conf" | sha256sum }}

if systemctl --user is-active --quiet pipewire; then
    systemctl --user restart pipewire pipewire-pulse wireplumber
fi
